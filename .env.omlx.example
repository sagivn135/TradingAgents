# Copy to .env. The model ID must match GET http://127.0.0.1:8000/v1/models.
TRADINGAGENTS_LLM_PROVIDER=openai_compatible
TRADINGAGENTS_LLM_BACKEND_URL=http://127.0.0.1:8000/v1
OPENAI_COMPATIBLE_API_KEY=SET_OMLX_API_KEY
TRADINGAGENTS_DEEP_THINK_LLM=gpt-oss-120b-MXFP4-Q8
TRADINGAGENTS_QUICK_THINK_LLM=gpt-oss-120b-MXFP4-Q8
TRADINGAGENTS_OUTPUT_LANGUAGE=Hebrew
TRADINGAGENTS_MAX_DEBATE_ROUNDS=1
TRADINGAGENTS_MAX_RISK_ROUNDS=1
TRADINGAGENTS_LLM_MAX_RETRIES=2
TRADINGAGENTS_MAX_TOKENS=4096
TRADINGAGENTS_RESULTS_DIR=./reports
TRADINGAGENTS_CACHE_DIR=./.local/cache
TRADINGAGENTS_MEMORY_LOG_PATH=./.local/memory/trading_memory.md
